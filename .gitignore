# Data (rebuilt from the raw downloads by src/data/build_master.py) — root-level only, so src/data/ code is tracked.
# Folder READMEs inside data/ are kept in git.
/data/**
!/data/**/
!/data/**/README.md
*.zip
*.parquet
*.pt
*.xlsx
*.pdf
*.pptx
*.png
# Large, rebuildable experiment output (python3 src/baselines/run_experiment.py)
results/**/predictions.csv
/results/expanded/*predictions.csv
# Immutable local copies of processed data, graphs, code and baseline results.
/results/frozen/
.DS_Store
__pycache__/
.venv/
wandb/
# Teammates' midterm report (contains names and roll numbers): keep out of git
# Reference material (PPT, papers, brief) stays local; only Markdown in docs/ is tracked
/docs/references/
docs/references/minor_report_updated.docx

.venv-expanded/

# Final-run inputs shipped with the team handoff.
!/data/graph_expanded/pyg/snapshots.pt
!/results/expanded/selected_test_predictions.csv
/HANDOFF_INVENTORY.csv
# S5 Round 2 model checkpoints and per-seed predictions (~200 MB): keep in a Kaggle dataset or Drive, not git.
results/s5_round2/*/checkpoints/
results/s5_round2/*/predictions/
# Phase A per-school residuals and run log (prediction-level data stays out of git)
results/phase_a/rolling_residuals.csv
results/phase_a/run.log
results/s5_round2/step2/*/checkpoints/
results/s5_round2/step2/*/predictions/
results/s5_round2/step1/*/checkpoints/
results/s5_round2/step1/*/predictions/
results/step4/*/origin_*/predictions/
results/step4/*.log
results/step4_relative/*/origin_*/predictions/
results/step4_relative/*.log
results/s6_rehearsal/neural/*/origin_*/predictions/
results/s6_rehearsal/*.log
results/s6_lock/*.log
